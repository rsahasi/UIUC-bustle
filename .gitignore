# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Secrets & local config
.env
*.env.local

# SQLite databases (seeded at runtime)
*.db

# macOS
.DS_Store

# Node / Expo
# No trailing slash: a trailing slash matches directories only, which let a
# `node_modules` symlink get committed past this rule.
node_modules
mobile/.expo/
mobile/dist/
mobile/.cache/

# Logs
*.log
/tmp/

# Test / build output
.pytest_cache/
coverage/
mobile/dist/
mobile/web-build/
.eas/
.expo-shared/

# Signing material — never commit
*.jks
*.p8
*.p12
*.mobileprovision
.env.*.local

# Claude internal
.claude/
.worktrees/
