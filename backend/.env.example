# ---- Required ----------------------------------------------------------
# PostgreSQL connection URL. Railway provides this automatically in prod.
# Without it every DB-backed route returns 503.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uiuc_bustle

# Champaign-Urbana MTD Developer API key — https://developer.cumtd.com
# Required for live departures and vehicle positions.
MTD_API_KEY=

# ---- Auth --------------------------------------------------------------
# Supabase JWT secret (Supabase dashboard: Settings -> API -> JWT Secret).
# Required for any authenticated route; unset yields 503 "Auth not configured".
SUPABASE_JWT_SECRET=

# Optional static API-key gate, independent of user auth.
API_KEY_REQUIRED=false
API_KEYS=

# ---- Optional integrations --------------------------------------------
# Anthropic key for AI ranking, walk encouragement, and EOD reports.
# Unset simply disables those features; endpoints fall back to heuristics.
CLAUDE_API_KEY=

# Google Places API (New) key for place search.
GOOGLE_PLACES_API_KEY=

# Sentry DSN for error monitoring. Unset disables Sentry.
SENTRY_DSN=

# ---- Server ------------------------------------------------------------
# Comma-separated allowed CORS origins. Empty denies all cross-origin
# requests. Dev example: http://localhost:8081,http://localhost:3000
CORS_ORIGINS=

# Base URL used to build share links. Falls back to the request Host header,
# which is client-controlled — set this explicitly in production.
PUBLIC_BASE_URL=

# Path to the GTFS SQLite database built by scripts/load_gtfs.py
GTFS_DB_PATH=data/gtfs.db

DEBUG=false
